</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 8rem 0 6rem;
  }

  /* Background layers */
  .hero__bg { position: absolute; inset: 0; pointer-events: none; }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
    transition: background-image 0.3s;
  }

  .hero__glow {
    position: absolute;
    top: 40%;
    left: 50%;
    width: 700px;
    height: 700px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, var(--hero-glow) 0%, rgba(6,182,212,0.04) 50%, transparent 70%);
    animation: glowPulse 5s ease-in-out infinite;
    transition: background 0.3s;
  }

  /* Content */
  .hero__content {
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .hero__greeting {
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--indigo-lt);
    letter-spacing: 0.04em;
    animation: fadeUp 0.5s var(--ease) both;
  }

  .hero__name {
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    animation: fadeUp 0.6s 0.1s var(--ease) both;
  }

  .hero__role {
    height: 1.8em;
    font-size: clamp(1rem, 2.5vw, 1.35rem);
    color: var(--text-2);
    font-weight: 500;
    animation: fadeUp 0.6s 0.2s var(--ease) both;
  }

  .hero__cursor {
    color: var(--indigo-lt);
    animation: blink 1s step-end infinite;
    font-weight: 300;
  }

  .hero__tagline {
    max-width: 560px;
    font-size: clamp(0.9rem, 1.5vw, 1rem);
    color: var(--text-3);
    line-height: 1.7;
    animation: fadeUp 0.6s 0.3s var(--ease) both;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    animation: fadeUp 0.6s 0.4s var(--ease) both;
  }

  .hero__links {
    display: flex;
    gap: 1.25rem;
    animation: fadeUp 0.6s 0.5s var(--ease) both;
    margin-top: 0.25rem;
  }
  .hero__links a {
    color: var(--text-3);
    transition: color 0.2s, transform 0.2s;
    display: flex;
  }
  .hero__links a:hover { color: var(--indigo-lt); transform: translateY(-2px); }

  /* Scroll indicator */
  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    color: var(--text-3);
    text-decoration: none;
    animation: scrollBounce 2s ease-in-out infinite, fadeIn 1s 1s both;
    transition: color 0.2s;
  }
  .hero__scroll:hover { color: var(--indigo-lt); }
  .hero__scroll span {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>

<script>
  const el = document.getElementById('typed')!;
  const roles = [
    'Senior Software Engineer',
    'Backend & Cloud Engineer',
    'Microservices Architect',
    'DevOps Enthusiast',
  ];
  let ri = 0, ci = 0, deleting = false;

  function tick() {
    const role = roles[ri];
    el.textContent = deleting ? role.slice(0, ci--) : role.slice(0, ci++);

    if (!deleting && ci > role.length) {
      deleting = true;
      setTimeout(tick, 2200);
      return;
    }
    if (deleting && ci < 0) {
      deleting = false;
      ci = 0;
      ri = (ri + 1) % roles.length;
    }
    setTimeout(tick, deleting ? 38 : 85);
  }

  tick();
</script>
